<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Koda E-Wallet</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light text-dark">
    <nav class="navbar navbar-expand-lg navbar-dark mb-4" style="background-color: #0b5cad;">
        <div class="container-fluid px-4">
            <a class="navbar-brand fw-bold" style="letter-spacing: 1px; font-size: 18px;" asp-controller="Home" asp-action="Index">KODA E-WALLET</a>
            <a class="nav-link text-white opacity-75" href="/swagger" target="_blank">API Docs (Swagger)</a>
        </div>
    </nav>

    <main class="container" style="max-width: 900px;">
        @* Pesan dari TempData (setelah redirect) *@
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success shadow-sm">@success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger shadow-sm">@error</div>
        }

        @RenderBody()
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
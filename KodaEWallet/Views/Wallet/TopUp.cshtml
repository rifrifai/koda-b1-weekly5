@using System.Globalization
@using KodaEWallet.DTOs
@using KodaEWallet.Helpers
@model TopUpRequest
@{
    ViewData["Title"] = "Top Up";
    var wallet = (WalletResponse)ViewBag.Wallet;
}

<h1 class="h3 mb-1">Top Up</h1>
<p class="text-secondary mb-4">@wallet.OwnerName (@wallet.WalletNumber) &middot; Saldo: <strong>@Format.Rupiah(wallet.Balance)</strong></p>

<form class="card shadow-sm border-0 mb-4" asp-action="TopUp" asp-route-userId="@wallet.UserId" method="post">
    <div class="card-body p-4">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm"></div>

        <div class="mb-3">
            <label for="Amount" class="form-label fw-bold">Nominal</label>
            <input type="number" step="0.01" class="form-control" id="Amount" name="Amount" placeholder="contoh: 100000"
                value="@(Model.Amount > 0 ? Model.Amount.ToString(CultureInfo.InvariantCulture) : "")" />
            <span class="text-danger small" asp-validation-for="Amount"></span>
        </div>

        <div class="mb-4">
            <label for="Description" class="form-label fw-bold">Keterangan (opsional)</label>
            <input type="text" class="form-control" id="Description" name="Description" value="@Model.Description" />
            <span class="text-danger small" asp-validation-for="Description"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary px-4">Top Up</button>
            <a class="btn btn-secondary px-4" asp-action="Dashboard" asp-route-userId="@wallet.UserId">Kembali</a>
        </div>
    </div>
</form>